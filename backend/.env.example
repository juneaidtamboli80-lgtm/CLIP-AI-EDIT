# Copy to backend/.env and adjust as needed.

# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite by default; swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./clipforge.db

# Storage: local | s3
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
STORAGE_PUBLIC_URL=http://localhost:8000/media

# S3-compatible storage (optional)
# S3_BUCKET=clipforge-media
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Uploads
MAX_UPLOAD_SIZE=2147483648
UPLOAD_CHUNK_SIZE=5242880

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
# true = run tasks inline (no Redis needed). Set false when the worker runs.
CELERY_TASK_ALWAYS_EAGER=true

# Pipeline
# Phase 1 ships with deterministic demo analysis. Set false only after Phase 2.
SIMULATION_MODE=true
SEED_DEMO_DATA=true
WHISPER_MODEL=large-v3

# LLM highlight scoring (Phase 3)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
